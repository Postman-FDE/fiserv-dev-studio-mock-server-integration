openapi: 3.0.3
info:
  version: 0.1-DRAFT
  title: CashFlow Central FI APIs
  description: REST API for CashFlow Central Enrollment.  This API documentation is currently draft.  This API is used in situations where the FI is the party making the calls.
  termsOfService: 'https://www.fiserv.com'
  contact:
    name: Fiserv
    email: matt.haar@fiserv.com
    url: www.fiserv.com
  license:
    url: 'https://www.fiserv.com'
    name: Fiserv Confidential - Limited
servers:
  - url: 'https://connect-dev.fiservapis.com/cfc'
    description: Lower region connectivity endpoint.
paths:
  '/fi/v1/businesses/{subscriber_or_common_id}':
    get:
      tags:
        - Enrollment and Sync
      summary: Retrieve a Small Business
      description: Retrieve a Small Business.
      operationId: get-businesses-id
      parameters:
        - name: id_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - CommonId
              - SubscriberId
            default: CommonId
        - name: subscriber_or_common_id
          in: path
          required: true
          schema:
            type: string
            pattern: '^[\w]+'
            minLength: 1
            maxLength: 32
      requestBody:
        content: {}
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BusinessGetResponse'
              examples:
                Returning a small business:
                  value:
                    id: 225a336007d44e35a9f94490b389b30d
                    self: /businesses/225a336007d44e35a9f94490b389b30d
                    modifiableFields:
                      - businessName
                      - businessAddress
                      - businessMobileNumber
                      - businessEmailAddress
                      - package
                    businessName: Shelli Scuba
                    businessAddress:
                      address1: 123 Main Street
                      city: Columbus
                      state: OH
                      zipCode: '43210'
                    businessMobileNumber: '6155555120'
                    businessEmailAddress: test@example.com
                    package: APBasic
                    taxId: '123456789'
        '401':
          description: Unauthorized
        '404':
          description: Not Found
      security:
        - {}
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Get small business by ID
      x-group-name: Enrollment and Sync
      x-child-product-name: FI Party
    patch:
      tags:
        - Enrollment and Sync
      summary: Modify a Small Business
      description: Modify the information pertaining to a Small Business.
      operationId: modify-business-by-sbsr-id
      parameters:
        - name: id_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - CommonId
              - SubscriberId
            default: CommonId
        - name: subscriber_or_common_id
          in: path
          required: true
          schema:
            type: string
            pattern: '^[\w]+'
            minLength: 1
            maxLength: 32
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                businessName:
                  $ref: '#/components/schemas/BusinessName'
                businessAddress:
                  $ref: '#/components/schemas/USAddress'
                businessMobileNumber:
                  $ref: '#/components/schemas/MobileNumber'
                businessEmailAddress:
                  $ref: '#/components/schemas/EmailAddress'
                package:
                  $ref: '#/components/schemas/Package'
            examples:
              Business Name Change:
                value:
                  businessName: Todd's Pizza
              Mobile and Email Change:
                value:
                  businessMobileNumber: '6785551212'
                  businessEmailAddress: todd@pizza.com
      responses:
        '204':
          description: No Content
        '400':
          description: Bad Request
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CFCResponse'
              examples:
                Input Validation Error:
                  value:
                    type: /problems/validation-error
                    title: Validation Error
                    detail: One or more fields failed validation.
                    errors:
                      - in: body
                        field: businessEmailAddress
                        message: Invalid businessEmailAddress format
                        sub-type: /problems/validation/input-validation
                    status: 400
                    instance: /businesses
                Package Modification:
                  value:
                    type: /problems/validation-error
                    title: Validation Error
                    detail: One or more fields failed validation.
                    errors:
                      - in: body
                        field: package
                        message: Business has more than package allowed number of users
                        sub-type: /problems/validation/input-validation
                    status: 400
                    instance: /businesses
        '401':
          description: Unauthorized
        '404':
          description: Not Found
      security:
        - {}
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Modify Small Business
      x-group-name: Enrollment and Sync
      x-child-product-name: FI Party
    delete:
      tags:
        - Enrollment and Sync
      summary: Inactivate a Small Business
      description: Inactivate a Small Business
      operationId: delete-business-by-sbsr-id
      parameters:
        - name: id_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - CommonId
              - SubscriberId
            default: CommonId
        - name: subscriber_or_common_id
          in: path
          required: true
          schema:
            type: string
            pattern: '^[\w]+'
            minLength: 1
            maxLength: 32
      responses:
        '204':
          description: No Content
        '401':
          description: Unauthorized
        '404':
          description: Not Found
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Inactivate a small business
      x-group-name: Enrollment and Sync
      x-child-product-name: FI Party
  '/fi/v1/businesses/{subscriber_or_common_id}/users':
    get:
      tags:
        - Users
      summary: Retrieve a List of Business Users
      description: Return a list of all Business Users associated with the Small Business.
      operationId: get-self-businesses-subscriberId-users
      parameters:
        - name: return_inactive_users
          in: query
          description: 'If true, this will return ALL users associated with the Small Business.  By default, this operation will only return active users.'
          schema:
            type: boolean
        - name: id_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - CommonId
              - SubscriberId
            default: CommonId
        - name: subscriber_or_common_id
          in: path
          required: true
          schema:
            type: string
            pattern: '^[\w]+'
            minLength: 1
            maxLength: 32
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                type: array
                maxItems: 1000
                items:
                  $ref: '#/components/schemas/User'
              examples:
                'TODO: Example 1':
                  value:
                    - self: /businesses/225a336007d44e35a9f94490b389b30d/users/115a336007d44e35a9f94490b389b30d
                      id: 225a336007d44e35a9f94490b389b30d
                      businessUser:
                        businessUserId: divecrew
                        businessUserName:
                          firstName: Dive
                          middleName: M
                          lastName: Crew
                        businessUserMobileNumber: '6142584525'
                        businessUserSSN: '123456789'
                        businessUserEmailAddress: divecrew@example.com
                      authorizationLevel: Level2
                      status: Pending
                      userType: AR
                      entitlements:
                        entitlementType: Selective
                        fundingAccountIds:
                          - 497f6eca62764993bfeb53cbbbba6f08
                      modifiableFields:
                        - businessUserName
                        - businessUserMobileNumber
                        - businessUserEmailAddress
                        - status
                        - authorizationLevel
                        - businessUserType
                        - userTransactionLimit
                        - entitlements
        '404':
          description: Not Found
      security:
        - {}
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Retrieve a list of users
      x-group-name: Enrollment and Sync
      x-child-product-name: FI Party
    post:
      tags:
        - Users
      summary: Create a Business User
      description: Add a Business User.
      operationId: post-businesses-subscriber_id-users
      parameters:
        - name: id_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - CommonId
              - SubscriberId
            default: CommonId
        - name: subscriber_or_common_id
          in: path
          required: true
          schema:
            type: string
            pattern: '^[\w]+'
            minLength: 1
            maxLength: 32
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                businessUser:
                  $ref: '#/components/schemas/BusinessUser'
                businessUserType:
                  $ref: '#/components/schemas/UserType'
                businessUserTransactionLimit:
                  description: Applicable for only LEVEL3 User
                  allOf:
                    - $ref: '#/components/schemas/UserPaymentLimit'
                authorizationLevel:
                  type: string
                  enum:
                    - Level2
                    - Level3
                entitlements:
                  $ref: '#/components/schemas/EntitledFundingAccountIds'
              required:
                - businessUserType
                - authorizationLevel
                - entitlements
            examples:
              'Level 2 ':
                value:
                  businessUser:
                    businessUserId: EEL_LEVEL2
                    businessUserName:
                      firstName: Liz
                      lastName: eel
                    businessUserMobileNumber: '6146141414'
                    businessUserSSN: '123456789'
                    businessUserEmailAddress: Liz_eel@yahoo.com
                  businessUserType: AP
                  authorizationLevel: Level2
                  entitlements:
                    entitlementType: Selective
                    fundingAccountIds:
                      - 497f6eca-6276-4993-bfeb-53cbbbba6f08
              Level 3:
                value:
                  businessUser:
                    businessUserId: Possums23
                    businessUserName:
                      firstName: Rajani
                      middleName: Hm
                      lastName: Possums
                    businessUserMobileNumber: '4704714701'
                    businessUserSSN: '123357890'
                    businessUserEmailAddress: Possums23@gmail.com
                  businessUserType: AR
                  businessUserTransactionLimit: 100
                  authorizationLevel: Level3
                  entitlements:
                    entitlementType: All
      responses:
        '201':
          description: Created
          content:
            application/json:
              schema:
                type: object
                properties:
                  id:
                    type: string
                  self:
                    $ref: '#/components/schemas/Self'
                  response:
                    $ref: '#/components/schemas/CFCResponse'
              examples:
                User added in Pending Status:
                  value:
                    id: 497f6eca62764993bfeb53cbbbba6f08
                    self: 'http://example.com'
                    response:
                      type: /info/useradded-pending
                      title: User added as pending. Needs activation
                      status: 201
                      detail: 'User added as pending, Business Level1 user need to activate it'
                      instance: businesses/497f6eca62764993bfeb53cbbbba6f08/users
        '400':
          description: Bad Request
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CFCResponse'
              examples:
                Validation Error for User Post:
                  value:
                    type: /problems/validation-error
                    title: Input Validation Error
                    detail: One or more fields failed validation
                    errors:
                      - in: body
                        field: userType
                        message: UserType is missing
                        sub-type: /problems/validation/input-validation
                      - in: body
                        field: businessUserId
                        message: User name is missing
                        sub-type: /problems/validation/input-validation
                    status: 400
                    instance: 'fi/v1/businesses/{subscriber_or_common_id}/users'
                Invalid user Type:
                  value:
                    type: /problems/validation-error
                    title: Validation Error
                    detail: One or more fields failed validation
                    errors:
                      - in: body
                        field: userType
                        message: UserType is invalid for the package
                        sub-type: /problems/validation/input-validation
                    status: 400
                    instance: 'fi/v1/businesses/{subscriber_or_common_id}/users'
                Duplicate User ID:
                  value:
                    type: /problems/duplicate-user
                    title: duplicate user
                    detail: business UserId exists in system
                    status: 400
                    instance: 'fi/v1/businesses/{subscriber_or_common_id}/users'
                Invalid Funding account combination:
                  value:
                    type: /problems/validation-error
                    title: Validation Error
                    detail: One or more fields failed validation
                    errors:
                      - in: body
                        field: entitelments
                        message: no funding account Ids were specified
                        sub-type: /problems/validation/input-validation
                    status: 400
                    instance: 'fi/v1/businesses/{subscriber_or_common_id}/users'
        '401':
          description: Unauthorized
      security:
        - {}
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Create a business user
      x-group-name: Enrollment and Sync
      x-child-product-name: FI Party
  '/fi/v1/businesses/{subscriber_or_common_id}/users/{commonId}}':
    get:
      tags:
        - Users
      summary: Retrieve a Business User
      description: Retrieve a single Business User.
      operationId: get-businessuser-by-userId
      parameters:
        - name: id_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - CommonId
              - SubscriberId
            default: CommonId
        - name: commonId
          in: path
          required: true
          schema:
            type: string
            pattern: '^[A-Za-z0-9]+'
            maxLength: 32
        - name: subscriber_or_common_id
          in: path
          required: true
          schema:
            type: string
            pattern: '^[\w]+'
            minLength: 1
            maxLength: 32
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
              examples:
                Active user:
                  value:
                    self: /businesses/225a336007d44e35a9f94490b389b30d/users/115a336007d44e35a9f94490b389b30d
                    id: 225a336007d44e35a9f94490b389b30d
                    businessUser:
                      businessUserId: divecrew
                      businessUserName:
                        firstName: Dive
                        middleName: M
                        lastName: Crew
                      businessUserMobileNumber: '6142584525'
                      businessUserSSN: '123456789'
                      businessUserEmailAddress: divecrew@example.com
                    authorizationLevel: Level2
                    status: Active
                    userType: AP
                    entitlements:
                      entitlementType: All
                      fundingAccountIds:
                        - 497f6eca62764993bfeb53cbbbba6f08
                    modifiableFields:
                      - businessUserName
                      - businessUserMobileNumber
                      - businessUserEmailAddress
                      - status
                      - authorizationLevel
                      - businessUserType
                      - userTransactionLimit
                      - entitlements
                Pending user:
                  value:
                    self: /businesses/225a336007d44e35a9f94490b389b30d/users/115a336007d44e35a9f94490b389b30d
                    id: 225a336007d44e35a9f94490b389b30d
                    businessUser:
                      businessUserId: divecrew
                      businessUserName:
                        firstName: Dive
                        middleName: M
                        lastName: Crew
                      businessUserMobileNumber: '6142584525'
                      businessUserSSN: '123456789'
                      businessUserEmailAddress: divecrew@example.com
                    authorizationLevel: Level2
                    status: Pending
                    userType: AR
                    entitlements:
                      entitlementType: Selective
                      fundingAccountIds:
                        - 497f6eca62764993bfeb53cbbbba6f08
                    modifiableFields:
                      - businessUserName
                      - businessUserMobileNumber
                      - businessUserEmailAddress
                      - status
                      - authorizationLevel
                      - businessUserType
                      - userTransactionLimit
                      - entitlements
        '401':
          description: Unauthorized
        '404':
          description: Not Found
      security:
        - {}
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Retrieve a business user
    delete:
      tags:
        - Users
      summary: Delete a Business User
      description: Delete a single Business User.
      operationId: delete-businesses-subscriber_id-users-user_id
      parameters:
        - name: id_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - CommonId
              - SubscriberId
            default: CommonId
        - name: commonId
          in: path
          required: true
          schema:
            type: string
            pattern: '^[A-Za-z0-9]+'
            maxLength: 32
        - name: subscriber_or_common_id
          in: path
          required: true
          schema:
            type: string
            pattern: '^[\w]+'
            minLength: 1
            maxLength: 32
      responses:
        '204':
          description: No Content
        '401':
          description: Unauthorized
        '404':
          description: Not Found
      security:
        - {}
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Delete a business user
    patch:
      tags:
        - Users
      summary: Modify a Business User
      description: Modify the information pertaining to a Business User.
      operationId: patch-businesses-subscriber_id-users-user_id
      parameters:
        - name: id_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - CommonId
              - SubscriberId
            default: CommonId
        - name: commonId
          in: path
          required: true
          schema:
            type: string
            pattern: '^[A-Za-z0-9]+'
            maxLength: 32
        - name: subscriber_or_common_id
          in: path
          required: true
          schema:
            type: string
            pattern: '^[\w]+'
            minLength: 1
            maxLength: 32
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UserPatchRequest'
            examples:
              Updating Pending User details:
                value:
                  businessUserType: AP
                  authorizationLevel: Level2
                  businessUserName:
                    firstName: Rob
                    lastName: Keneddy
                  businessUserMobileNumber: '6146146614'
                  businessUserEmailAddress: user@example.com
                  businessUserTransactionLimit: 100
                  entitlements:
                    entitlementType: All
                  activateUser: false
              Update User type:
                $ref: '#/components/examples/Update-User-Type'
              Update level 2/3 authorization level:
                $ref: '#/components/examples/Update-authorization-level'
              Example 1:
                value:
                  businessUserType: AP
                  authorizationLevel: Level2
                  businessUserName:
                    firstName: string
                    middleName: string
                    lastName: string
                  businessUserMobileNumber: stringstri
                  businessUserEmailAddress: user@example.com
                  businessUserTransactionLimit: 1
                  entitlements:
                    entitlementType: All
                    fundingAccountIds:
                      - 497f6eca-6276-4993-bfeb-53cbbbba6f08
                  activateUser: false
      responses:
        '204':
          description: No Content
        '400':
          description: Bad Request
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CFCResponse'
              examples:
                Input validation error:
                  value:
                    type: /problems/validation-error
                    title: Input Validation Error
                    detail: One or more fields failed validation
                    status: 400
                    instance: 'fi/v1/businesses/users/{commonId}'
                    errors:
                      - in: body
                        field: businessUserType
                        message: UserType is invalid
                        sub-type: /problems/validation/input-validation
                      - in: body
                        field: authorizationLevel
                        message: inavalid authorizationLevel
                        sub-type: /problems/validation/input-validation
                User already active:
                  value:
                    type: /problems/invalid-request
                    title: user alredy active
                    status: 400
                    detail: user is in active status
                    instance: 'fi/v1/businesses/users/{commonId}'
                Not allowed update authorization to Level1:
                  value:
                    type: /problems/authorizationLevel
                    title: Invalid authorization Level
                    status: 400
                    detail: this endpoint can not used to change authorizationLevel to level1
                    instance: 'fi/v1/businesses/users/{commonId}'
        '401':
          description: Unauthorized
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CFCResponse'
        '404':
          description: Not Found
      security:
        - {}
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Modify a business user
  /fi/v1/businesses:
    post:
      tags:
        - Enrollment and Sync
      summary: Create a Small Business
      description: Add a Small Business.
      operationId: ''
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                subscriberId:
                  description: "This ID should contain at least nine characters. Do not include special characters (such\r\nas # or &). Do not use a Social Security number."
                  allOf:
                    - $ref: '#/components/schemas/SubscriberId'
                businessName:
                  description: 'Provide doing business as name for the Business - if the length is greater than 35, the name will be truncated when printed on the check.'
                  allOf:
                    - $ref: '#/components/schemas/BusinessName'
                taxId:
                  $ref: '#/components/schemas/TaxId'
                businessAddress:
                  $ref: '#/components/schemas/USAddress'
                businessMobileNumber:
                  $ref: '#/components/schemas/MobileNumber'
                businessEmailAddress:
                  $ref: '#/components/schemas/EmailAddress'
                businessType:
                  $ref: '#/components/schemas/BusinessTypes'
                package:
                  $ref: '#/components/schemas/Package'
                businessUser:
                  $ref: '#/components/schemas/BusinessUser'
                fundingAccount:
                  $ref: '#/components/schemas/FundingAccount'
                accountsReceivables:
                  $ref: '#/components/schemas/ARData'
              required:
                - subscriberId
                - businessName
                - taxId
                - businessAddress
                - businessMobileNumber
                - businessEmailAddress
                - businessType
                - package
                - businessUser
                - fundingAccount
            examples:
              Enrollment:
                value:
                  subscriberId: '1234567890'
                  businessName: Shelli's Scuba
                  taxId: '332287654'
                  businessAddress:
                    address1: 123 Main Street
                    city: Columbus
                    state: OH
                    zipCode: '43210'
                  businessMobileNumber: '6145551212'
                  businessEmailAddress: user@example.com
                  businessType: SoleProprietorship
                  package: APBasic
                  businessUser:
                    businessUserId: ShelliTheOwner
                    businessUserName:
                      firstName: Shelli
                      lastName: Smith
                    businessUserMobileNumber: '6145551212'
                    businessUserSSN: '877661234'
                    businessUserEmailAddress: user@example.com
                  fundingAccount:
                    bankAccount:
                      routingTransitNumber: '123456789'
                      accountType: Checking
                      accountNumber: '998877665544'
                    'accountNickname ': My Checking
                    accountCategory: Business
      responses:
        '201':
          description: Created
          content:
            application/json:
              schema:
                type: object
                properties:
                  id:
                    type: string
                  self:
                    type: string
                    format: uri
              examples:
                Successful Response:
                  value:
                    id: 497f6eca62764993bfeb53cbbbba6f08
                    self: /businesses/497f6eca62764993bfeb53cbbbba6f08
        '400':
          description: Bad Request
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CFCResponse'
              examples:
                Input Validation:
                  value:
                    type: /problems/validation-error
                    title: Validation Error
                    status: 400
                    detail: One or more fields failed validation.
                    instance: /businesses
                    errors:
                      - in: body
                        sub-type: /problems/validation/input-validation
                        field: accountNumber
                        message: Account number not is correct format
                      - in: body
                        sub-type: /problems/validation/missing-required
                        field: RoutingTransitNumber
                        message: The RoutingTransitNumber field is required.
                Duplicate Subscriber:
                  value:
                    type: /problems/duplicate-subscriber
                    title: Duplicate Subscriber
                    status: 400
                    detail: Subscriber already exists
                    instance: /businesses
                Funding Account Failed:
                  value:
                    type: /problems/invalid-funding-account-error
                    title: Invalid funding account
                    status: 400
                    detail: Bank account RTN is invalid or not electronic
                    instance: /businesses
                Duplicate Business User:
                  value:
                    type: /problems/duplicate-business-user-error
                    title: Duplicate business user
                    status: 400
                    detail: The business user ID already exists
                    instance: /businesses
                Package Validation Error:
                  value:
                    type: /problems/validation-error
                    title: Validation Error
                    detail: One or more fields failed validation.
                    errors:
                      - in: body
                        field: package
                        message: FI can only enroll with APBasic package.
                        sub-type: /problems/validation/input-validation
                    status: 400
                    instance: /businesses
        '401':
          description: Unauthorized
      security:
        - {}
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Create a small business
  /fi/v1/migrations:
    post:
      tags:
        - Migrations
      summary: Create Migration Request
      description: "Create a user migration request. After the request has been posted, \r\nmigration is done the following Saturday."
      operationId: post-migration
      requestBody:
        description: ok
        content:
          application/json:
