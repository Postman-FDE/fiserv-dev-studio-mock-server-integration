  '/fi/v1/businesses/{subscriber_or_common_id}/users/{commonId}/changetolevel1':
    patch:
      tags:
        - Users
      summary: Change User to Level 1
      description: "Change a Level 2 or Level 3 Business User to Level 1. \r\nThis operation can be used by Level 1 users only. \r\nLevel 1 would be marked as deleted (inactivated)"
      operationId: patch-businesses-id-users-promote
      parameters:
        - name: id_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - CommonId
              - SubscriberId
            default: CommonId
        - name: commonId
          in: path
          required: true
          schema:
            type: string
            pattern: '^[A-Za-z0-9]+'
            maxLength: 32
        - name: subscriber_or_common_id
          in: path
          required: true
          schema:
            type: string
            pattern: '^[\w]+'
            minLength: 1
            maxLength: 32
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                businessUserID:
                  description: "User ID that needs to be promoted\r\n"
                  allOf:
                    - $ref: '#/components/schemas/UserId'
                businessUserSSN:
                  $ref: '#/components/schemas/TaxId'
              required:
                - businessUserID
                - businessUserSSN
            examples:
              Example 1:
                value:
                  businessUserID: rob_123
                  businessUserSSN: '123456789'
      responses:
        '204':
          description: No Content
        '400':
          description: Bad Request
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CFCResponse'
              examples:
                Input validation error:
                  value:
                    type: /problems/validation-error
                    title: Validation Error
                    status: 400
                    detail: One or more fields failed validation
                    instance: '/businesses/{subscriber_or_common_id}/users/{commonId}/changetolevel1'
                    errors:
                      - in: body
                        sub-type: /problems/validation/input-validation
                        field: businessUserSSN
                        message: SSN is not valid
                User ID not found:
                  value:
                    type: /problems/user-not-found
                    title: user ID not found
                    status: 400
                    detail: user not found
                    instance: /businesses/225a336007d44e35a9f94490b389b30d/users/115a336007d44e35a9f94490b389b30d/changetolevel1
        '401':
          description: Unauthorized
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CFCResponse'
              examples:
                Example 1:
                  $ref: '#/components/examples/Not-authorized'
        '404':
          description: Not Found
      security:
        - {}
      servers:
        - url: 'https://connect-dev.fiservapis.com/cfc'
          description: Lower region connectivity endpoint.
      x-proxy-name: Promote a user to level 1
tags:
  - name: BillPay
  - name: Enrollment
components:
  parameters:
    IdType:
      name: id_type
      in: query
      required: false
      schema:
        type: string
        enum:
          - CommonId
          - SubscriberId
        default: CommonId
    subscriber_or_common_id:
      name: subscriber_or_common_id
      in: path
      required: true
      schema:
        type: string
        pattern: '^[\w]+'
        minLength: 1
        maxLength: 32
    commonid:
      name: commonId
      in: path
      required: true
      schema:
        type: string
        pattern: '^[A-Za-z0-9]+'
        maxLength: 32
  securitySchemes:
    OAuth2BearerToken:
      type: http
      scheme: bearer
  examples:
    Validation-Error:
      value:
        type: /problems/validation-error
        title: Validation Error
        status: 400
        detail: One or more fields failed validation.
        instance: /businesses
        errors:
          - in: body
            sub-type: /problems/validation/input-validation
            field: accountNumber
            message: Account number not is correct format
          - in: body
            sub-type: /problems/validation/missing-required
            field: RoutingTransitNumber
            message: The RoutingTransitNumber field is required.
    Active-Pending-user:
      value:
        activateUser: true
    Update-Pending-User-details:
      value:
        businessUserType: AP
        authorizationLevel: Level2
        businessUserName:
          firstName: Rob
          lastName: Keneddy
        businessUserMobileNumber: '6146146614'
        businessUserEmailAddress: user@example.com
        businessUserTransactionLimit: 100
        entitlements:
          entitlementType: All
        activateUser: false
    Update-User-Type:
      value:
        businessUserType: AR
    Update-authorization-level:
      value:
        authorizationLevel: Level2
    Not-authorized:
      value:
        type: /problems/user-not-authorized
        title: user alredy active
        status: 401
        detail: user not allowed to perform operation
        instance: /businesses/225a336007d44e35a9f94490b389b30d/users/115a336007d44e35a9f94490b389b30d/changetolevel1
  schemas:
    BusinessGetResponse:
      type: object
      title: BusinessGetResponse
      properties:
        self:
          $ref: '#/components/schemas/Self'
        id:
          type: string
        businessType:
          $ref: '#/components/schemas/BusinessTypes'
        businessName:
          $ref: '#/components/schemas/BusinessName'
        businessAddress:
          $ref: '#/components/schemas/USAddress'
        businessMobileNumber:
          $ref: '#/components/schemas/MobileNumber'
        businessEmailAddress:
          $ref: '#/components/schemas/EmailAddress'
        package:
          $ref: '#/components/schemas/Package'
        taxId:
          $ref: '#/components/schemas/TaxId'
        modifiableFields:
          $ref: '#/components/schemas/ModifiableFields'
      example:
        id: 225a336007d44e35a9f94490b389b30d
        self: /businesses/225a336007d44e35a9f94490b389b30d
        modifiableFields:
          - businessName
          - businessAddress
          - businessMobileNumber
          - businessEmailAddress
          - package
        businessName: Shelli Scuba
        businessAddress:
          address1: 123 Main Street
          city: Columbus
          state: OH
          zipCode: '43210'
        businessMobileNumber: '6155555120'
        businessEmailAddress: test@example.com
        package: APBasic
        taxId: '123456789'
    Self:
      type: string
      title: Self
      format: uri-reference
      maxLength: 100
    BusinessTypes:
      type: string
      enum:
        - SoleProprietorship
        - LimitedPartnership
        - GeneralPartnership
        - Corporation
        - SCorporation
        - Other
      title: BusinessTypes
    BusinessName:
      type: string
      title: BusinessName
      pattern: '^[a-zA-Z0-9_(){}&@!+#.''$,%^*-]*'
      minLength: 2
      maxLength: 40
    USAddress:
      type: object
      title: USAddress
      properties:
        address1:
          type: string
          pattern: '^[\w]+[a-zA-Z0-9_@!+#.$,\s*\/%^ *-]*'
          minLength: 1
          maxLength: 32
        address2:
          type: string
          pattern: '^[a-zA-Z0-9_@!+#.$,\s\/%^ *-]+'
          minLength: 1
          maxLength: 32
        city:
          type: string
          pattern: '^[\w\s]+'
          minLength: 1
          maxLength: 32
        state:
          type: string
          pattern: '^[A-Z]{2}'
          minLength: 2
          maxLength: 2
          example: OH
        zipCode:
          type: string
          pattern: '^(\d{5}|\d{9}|\d{11})$'
          minLength: 5
          maxLength: 11
      required:
        - address1
        - city
        - state
        - zipCode
    MobileNumber:
      type: string
      title: MobileNumber
      pattern: '^[1-9][0-9]+$'
      minLength: 10
      maxLength: 10
    EmailAddress:
      type: string
      title: EmailAddress
      format: email
      minLength: 1
      maxLength: 100
    Package:
      type: string
      enum:
        - APBasic
        - APPro
        - APARBasic
        - APARPro
      title: Package
    TaxId:
      type: string
      title: TaxId
      pattern: '^[0-9]+'
      minLength: 9
      maxLength: 9
    ModifiableFields:
      type: array
      title: ModifiableFields
      maxItems: 99
      items:
        type: string
        pattern: ^\w+$
        minLength: 1
        maxLength: 100
    CFCResponse:
      type: object
      properties:
        type:
          type: string
        title:
          type: string
        status:
          type: integer
          format: int32
        detail:
          type: string
        instance:
          type: string
        errors:
          type: array
          items:
            type: object
            properties:
              in:
                type: string
              sub-type:
                type: string
              field:
                type: string
              message:
                type: string
      x-examples:
        Example 1:
          type: /problems/validation-error
          title: Validation Error
          status: 400
          detail: One or more fields failed validation
          instance: users/v1/self/payees
          errors:
            - in: body
              sub-type: /problems/validation/input-validation
              field: accountNumber
              message: Account number not is correct format
            - in: body
              sub-type: field/validation
              field: RoutingTransitNumber
              message: The RoutingTransitNumber field is required.
      example:
        type: /problems/validation-error
        title: Validation Error
        status: 400
        detail: One or more fields failed validation
        instance: users/v1/self/payees
        errors:
          - in: body
            sub-type: /problems/validation/input-validation
            field: accountNumber
            message: Account number not is correct format
          - in: body
            sub-type: field/validation
            field: RoutingTransitNumber
            message: The RoutingTransitNumber field is required.
    User:
      type: object
      title: User
      properties:
        self:
          $ref: '#/components/schemas/Self'
        id:
          type: string
        businessUser:
          $ref: '#/components/schemas/BusinessUser'
        authorizationLevel:
          $ref: '#/components/schemas/AuthorizationLevel'
        status:
          type: string
          enum:
            - Active
            - Inactive
            - Pending
        businessUserType:
          $ref: '#/components/schemas/UserType'
        userTransactionLimit:
          $ref: '#/components/schemas/UserPaymentLimit'
        entitlements:
          $ref: '#/components/schemas/EntitledFundingAccountIds'
        modifiableFields:
          $ref: '#/components/schemas/ModifiableFields'
    BusinessUser:
      type: object
      title: BusinessUser
      properties:
        businessUserId:
          $ref: '#/components/schemas/UserId'
        businessUserName:
          $ref: '#/components/schemas/Name'
        businessUserMobileNumber:
          $ref: '#/components/schemas/MobileNumber'
        businessUserSSN:
          description: Optional for adding level2 and level3 users
          allOf:
            - $ref: '#/components/schemas/TaxId'
        businessUserEmailAddress:
          $ref: '#/components/schemas/EmailAddress'
      required:
        - businessUserId
        - businessUserName
        - businessUserMobileNumber
        - businessUserEmailAddress
    UserId:
      type: string
      title: UserId
      pattern: '^[a-zA-Z][a-zA-Z0-9\\-_]+'
      minLength: 1
      maxLength: 32
    Name:
      type: object
      title: Name
      properties:
        firstName:
          type: string
          pattern: '^[a-zA-Z0-9., -_''!][\x20-\x7E]+'
          minLength: 1
          maxLength: 32
        middleName:
          type: string
          pattern: '^[a-zA-Z0-9., -_''!][\x20-\x7E]+'
          minLength: 1
          maxLength: 32
        lastName:
          type: string
          pattern: '^[a-zA-Z0-9., -_''!][\x20-\x7E]+'
          minLength: 1
          maxLength: 32
      required:
        - firstName
        - lastName
    AuthorizationLevel:
      type: string
      enum:
        - Level1
        - Level2
        - Level3
      title: AuthorizationLevel
    UserType:
      type: string
      enum:
        - AP
        - AR
        - All
      title: UserType
    UserPaymentLimit:
      type: integer
      title: UserPaymentLimit
      format: int32
      minimum: 1
      maximum: 999999
      nullable: true
    EntitledFundingAccountIds:
      type: object
      title: EntitledFundingAccountIds
      properties:
        entitlementType:
          type: string
          enum:
            - All
            - Selective
        fundingAccountIds:
          type: array
          description: Conditional (at least one must be passed if entitlementType is Selective)
          items:
            type: string
            format: uuid
      required:
        - entitlementType
    UserPatchRequest:
      type: object
      title: UserPatchRequest
      properties:
        businessUserType:
          $ref: '#/components/schemas/UserType'
        authorizationLevel:
          type: string
          enum:
            - Level2
            - Level3
        businessUserName:
          $ref: '#/components/schemas/Name'
        businessUserMobileNumber:
          $ref: '#/components/schemas/MobileNumber'
        businessUserEmailAddress:
          $ref: '#/components/schemas/EmailAddress'
        businessUserTransactionLimit:
          $ref: '#/components/schemas/UserPaymentLimit'
        entitlements:
          $ref: '#/components/schemas/EntitledFundingAccountIds'
        activateUser:
          type: boolean
          description: 'activateUser - "True" will activate the business user to access CFC functionality '
          default: false
    SubscriberId:
      type: string
      title: SubscriberId
      pattern: '^[A-Z0-9_(){}&@!+#.''$,%^*-]*'
      minLength: 1
      maxLength: 32
    FundingAccount:
      type: object
      title: FundingAccount
      properties:
        bankAccount:
          $ref: '#/components/schemas/BankAccountDetail'
        'accountNickname ':
          type: string
        accountCategory:
          type: string
          enum:
            - Personal
            - Business
      required:
        - bankAccount
        - accountCategory
    BankAccountDetail:
      type: object
      title: BankAccountDetail
      properties:
        routingTransitNumber:
          $ref: '#/components/schemas/RoutingTransitNumber'
        accountType:
          $ref: '#/components/schemas/AccountType'
        accountNumber:
          $ref: '#/components/schemas/AccountNumber'
      required:
        - routingTransitNumber
        - accountType
        - accountNumber
    RoutingTransitNumber:
      type: string
      title: RoutingTransitNumber
      pattern: '^[0-9]{9}$'
      minLength: 9
      maxLength: 9
    AccountType:
      type: string
      enum:
        - MoneyMarket
        - Checking
      title: AccountType
    AccountNumber:
      type: string
      title: AccountNumber
      pattern: '^[a-zA-Z0-9]{1,22}$'
      minLength: 1
      maxLength: 22
    ARData:
      type: object
      title: ARData
      properties:
        legalName:
          $ref: '#/components/schemas/LegalName'
        irsFilingName:
          $ref: '#/components/schemas/BusinessName'
        registrationAddress:
          description: Provide the legal address for the Business.
          allOf:
            - $ref: '#/components/schemas/USAddress'
        checkDeliveryAddress:
          description: This is the address where a business will receive check payments.
          allOf:
            - $ref: '#/components/schemas/USAddress'
        emailAddress:
          $ref: '#/components/schemas/EmailAddress'
        dateIncorporated:
          type: string
          format: date
          example: '2023-10-10'
        websiteUrl:
          type: string
          format: uri
          example: 'https://technologi.co.uk'
        productServicesSold:
          type: string
          minLength: 1
          maxLength: 100
          example: Additional detail provide
        annualTurnover:
          type: number
          format: double
          example: 100000
        annualCardTurnover:
          type: number
          format: float
          example: 100000
        avgTicketSalesAmount:
          type: number
          format: float
          example: 500
        owners:
          type: array
          items:
            type: object
            properties:
              ownerName:
                $ref: '#/components/schemas/Name'
              dateOfBirth:
                type: string
                format: date
              nationality:
                type: string
                description: The country code table includes the WITS System country
                pattern: '[a-zA-Z]{2,}'
                minLength: 1
                example: USA
              position:
                type: string
                enum:
                  - Vice President
                  - President
                  - Treasurer
                  - Owner
                  - Partner
                  - CEO
                  - Secretary
                  - Director
                  - Sole Propietor
                  - COO
                  - CFO
                  - Member LLC
                  - Other
                description: 'Position of principal in company, ie. Owner, CEO, LLC. Should match business type. Optional for other principals'
              phoneNo:
                $ref: '#/components/schemas/MobileNumber'
              emailAddress:
                description: test@test.com
                allOf:
                  - $ref: '#/components/schemas/EmailAddress'
              ssn:
                $ref: '#/components/schemas/TaxId'
              mainPrincipal:
                type: boolean
                description: "Main principal flag - indicates signor\r\n"
                default: false
              percentage:
                type: integer
                description: Percentage of ownership in business. All Principals above 25% should be listed in this array
                format: int32
                example: 12.05
              ownerAddress:
                $ref: '#/components/schemas/USAddress'
    LegalName:
      type: string
      title: LegalName
      pattern: '^[a-zA-Z0-9_(){}&@!+#.''$,%^*-]*'
      minLength: 2
      maxLength: 24
    MigrationRequest:
      type: object
      title: MigrationRequest
      properties:
        sourceSponsorId:
          $ref: '#/components/schemas/SubscriberId'
        'sourceSubscriberId ':
          $ref: '#/components/schemas/SubscriberId'
        targetSponsorId:
          $ref: '#/components/schemas/SubscriberId'
        'targetSubscriberId ':
          $ref: '#/components/schemas/SubscriberId'
        businessName:
          $ref: '#/components/schemas/BusinessName'
        businessType:
          $ref: '#/components/schemas/BusinessTypes'
        businessUser:
          $ref: '#/components/schemas/BusinessUser'
      required:
        - sourceSponsorId
        - 'sourceSubscriberId '
        - targetSponsorId
        - 'targetSubscriberId '
    LDDGetStatus:
      type: object
      properties:
        agreementRequired:
          type: boolean
        firstTimeAcceptance:
          type: boolean
        legalDocumentType:
          $ref: '#/components/schemas/LDDTypes'
        legalDocumentUri:
          type: string
        locale:
          $ref: '#/components/schemas/Locale'
      x-examples:
        Example 1:
          agreementRequired: true
          firstTimeAcceptance: true
          legalDocumentType: ESIGN
          legalDocumentUri: 'http://example.com'
          locale: en-US
      example:
        agreementRequired: true
        firstTimeAcceptance: true
        legalDocumentType: 'TermsAndConditions '
        legalDocumentUri: string
        locale: en-US
    LDDTypes:
      type: string
      enum:
        - 'TermsAndConditions '
        - PrivacyPolicy
        - ESign
        - ESign-PrivacyPolicy
      title: LDDTypes
    Locale:
      title: Locale
      enum:
        - en-US
    LDDGetContent:
      type: object
      properties:
        agreementRequired:
          type: boolean
        firstTimeAcceptance:
          type: boolean
        legalDocumentType:
          $ref: '#/components/schemas/LDDTypes'
        legalDocumentUri:
          type: string
          format: uri
        locale:
          $ref: '#/components/schemas/Locale'
        legalDocumentContent:
          type: string
      x-examples:
        Example 1:
          agreementRequired: true
          firstTimeAcceptance: true
          legalDocumentType: ESIGN
          legalDocumentUri: 'http://example.com'
          locale: en-US
          legalDocumentContent: string
    CardAccountResponse:
      type: object
      title: CardAccountResponse
      properties:
        self:
          type: string
          format: uri
        id:
          type: string
        cardNumberMasked:
          type: string
          minLength: 15
          maxLength: 19
        modifiableFields:
          $ref: '#/components/schemas/ModifiableFields'
        debitCard:
          type: boolean
        cardType:
          $ref: '#/components/schemas/CardType'
        billingAddress:
          $ref: '#/components/schemas/USAddress'
        expirationYear:
          $ref: '#/components/schemas/ExpirationYear'
        expirationMonth:
          $ref: '#/components/schemas/ExpirationMonth'
        externalAccountDescription:
          description: "If a calling application does not provide an externalAccountDescription when adding a card, the value will be populated with default (example: 'VISA-1234')\r\n\r\n"
          allOf:
            - $ref: '#/components/schemas/ExternalAccountDescription'
        nameOnCard:
          $ref: '#/components/schemas/NameOnCard'
        nickname:
          $ref: '#/components/schemas/nickname'
      required:
        - self
        - id
        - cardNumberMasked
        - modifiableFields
        - billingAddress
        - expirationYear
        - expirationMonth
        - nameOnCard
    CardType:
      type: string
      enum:
        - Visa
        - MasterCard
        - AmericanExpress
        - Discover
      title: CardType
    ExpirationYear:
      type: string
      title: ExpirationYear
      pattern: '^(20[0-9]{2})$'
      minLength: 4
      maxLength: 4
      example: '2023'
    ExpirationMonth:
      type: string
      title: ExpirationMonth
      pattern: '^([1-9]|1[012])$'
      minLength: 1
      maxLength: 2
      example: '1'
    ExternalAccountDescription:
      type: string
      title: ExternalAccountDescription
      pattern: '^(?!\\s)[a-zA-Z''-]{2,32}(?: [a-zA-Z''-]{2,32}){0,2}$'
      maxLength: 32
    NameOnCard:
      type: string
      title: NameOnCard
      pattern: '^[a-zA-Z]+(?:[\\s.]+[a-zA-Z]+)*$'
      maxLength: 80
    nickname:
      type: string
      title: nickname
      pattern: '^[a-zA-Z][a-zA-Z0-9\\\\s]*$'
      maxLength: 30
    InternalCardAccountPatch:
      type: object
      title: InternalCardAccountPatch
      properties:
        billingAddress:
          $ref: '#/components/schemas/USAddress'
        expirationYear:
          $ref: '#/components/schemas/ExpirationYear'
        expirationMonth:
          $ref: '#/components/schemas/ExpirationMonth'
        externalAccountDescription:
          $ref: '#/components/schemas/ExternalAccountDescription'
        nameOnCard:
          $ref: '#/components/schemas/NameOnCard'
        nickname:
          $ref: '#/components/schemas/nickname'
        cvv:
          $ref: '#/components/schemas/CVV'
    CVV:
      type: string
      title: CVV
      pattern: '^[0-9]*'
      minLength: 3
      maxLength: 4
    BankAccountGetResponse:
      type: object
      properties:
        self:
          type: string
          format: uri
        id:
          type: string
        unmaskedAccountNumberUri:
          type: string
          format: uri
        bankAccount:
          $ref: '#/components/schemas/BankAccountDetailMasked'
        nickname:
          $ref: '#/components/schemas/nickname'
        accountCategory:
          $ref: '#/components/schemas/AccountCategory'
        businessName:
          $ref: '#/components/schemas/BusinessName'
        primaryAccountOwner:
          $ref: '#/components/schemas/PrimaryBankAccountOwner'
        accountStatus:
          $ref: '#/components/schemas/BankAccountStatus'
        bankAccountAddress:
          $ref: '#/components/schemas/USAddress'
        preferredAccount:
          type: boolean
          default: false
        billingAccount:
          type: boolean
          default: false
        accountBalance:
          type: integer
      x-examples:
        Example 1:
          self: ../dictionary
          id: string
          maskedAccountNumber: string
          unmaskedAccountNumberUri: ../dictionary
          bankAccount:
            routingTransitNumber: stringstr
            accountType: Checking
            accountNumber: string
          nickname: string
          accountCategory: Business
          businessName: string
          primaryAccountOwner: string
          accountStatus: Active
          bankAddress:
            address1: string
            address2: string
            city: string
            state: st
            zipCode: string
          preferredAccount: true
          billingAccount: true
          accountBalance: 100
    BankAccountDetailMasked:
      type: object
      title: BankAccountDetailMasked
      properties:
        routingTransitNumber:
          $ref: '#/components/schemas/RoutingTransitNumber'
        accountType:
          $ref: '#/components/schemas/AccountType'
        accountNumberMasked:
          type: string
          minLength: 1
          maxLength: 22
          example: '****123'
    AccountCategory:
      type: string
      enum:
        - Business
        - Personal
      title: AccountCategory
    PrimaryBankAccountOwner:
      type: string
      title: PrimaryBankAccountOwner
      pattern: '^[a-zA-Z0-9_(){}&@!+#.''$,%^ *-]*'
      minLength: 1
      maxLength: 35
    BankAccountStatus:
      type: string
      enum:
        - Active
        - Inactive
      title: BankAccountStatus
security:
  - {}
